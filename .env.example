# کلید(های) API گروک (Groq) — این فایل را به .env کپی کرده و مقدار واقعی را وارد کنید
# کلید رایگان را از https://console.groq.com/keys بگیرید

# کلید اصلی (الزامی)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# مدل‌های فعلی Groq (llama-3.3-70b-versatile و llama-3.1-8b-instant در ۱۶ اوت ۲۰۲۶ حذف شدند):
#   openai/gpt-oss-120b   -> کیفیت بالا (جایگزین رسمی llama-3.3-70b-versatile)
#   openai/gpt-oss-20b    -> سریع‌تر و سبک‌تر (جایگزین رسمی llama-3.1-8b-instant)
#   qwen/qwen3.6-27b      -> گزینه‌ی جایگزین دیگر
# لیست به‌روز: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# حداقل امتیاز بازیابی برای این‌که یک نتیجه «مرتبط» در نظر گرفته شود (پیش‌فرض کافی است)
MIN_RELEVANCE_SCORE=0.03

# تنظیمات اختیاری RAG
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_DEFAULT=4
PORT=5000
